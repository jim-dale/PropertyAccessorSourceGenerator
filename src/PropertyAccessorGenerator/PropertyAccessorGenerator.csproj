<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsRolynComponent>true</IsRolynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>true</IsPackable>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <PackageId>PropertyAccessorGenerator</PackageId>
    <Authors>Jim Dale</Authors>
    <Description>A source generator that creates an extension method to access public properties of a class or struct by name.</Description>
    <!--<PackageProjectUrl>https://github.com/yourrepo</PackageProjectUrl>-->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--<RepositoryUrl>https://github.com/yourrepo</RepositoryUrl>-->
    <RepositoryType>git</RepositoryType>
    <PackageTags>properties attribute generator generation codegen codegenerator codegeneration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\"/>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\Annotations.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(OutputPath)\Annotations.dll" Pack="true" PackagePath="lib\netstandard2.0" Visible="false" />
    <None Include="$(OutputPath)\Annotations.xml" Pack="true" PackagePath="lib\netstandard2.0" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Annotations\Annotations.csproj" PrivateAssets="All" />
  </ItemGroup>

</Project>
